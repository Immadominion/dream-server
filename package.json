{
    "name": "@dream/server",
    "version": "0.1.0",
    "description": "Dream Server — always-on copy-trading engine (Phoenix perps + Privy server signers)",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "policy:update": "tsx scripts/update-signer-policy.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "dbc:create-config": "tsx scripts/create-dream-dbc-config.ts"
    },
    "keywords": [
        "solana",
        "phoenix",
        "perps",
        "copy-trading",
        "privy",
        "dream"
    ],
    "license": "Apache-2.0",
    "dependencies": {
        "@hono/node-server": "^1.19.9",
        "@hono/zod-validator": "^0.7.6",
        "@meteora-ag/dynamic-bonding-curve-sdk": "2.0.0",
        "@privy-io/server-auth": "^1.21.0",
        "@solana/web3.js": "^1.98.4",
        "bn.js": "^5.2.5",
        "bs58": "^6.0.0",
        "dotenv": "^16.6.1",
        "drizzle-orm": "^0.45.1",
        "hono": "^4.12.3",
        "pg": "^8.19.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "tweetnacl": "^1.0.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@solana/spl-token": "^0.4.15",
        "@types/bn.js": "^5.2.0",
        "@types/node": "^22.19.12",
        "@types/pg": "^8.18.0",
        "drizzle-kit": "^0.31.9",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "overrides": {
        "uuid": "^9.0.1"
    }
}

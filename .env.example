# ── Server ───────────────────────────────────────────────
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated allowed CORS origins. Never use "*" in production.
CORS_ORIGINS=*

# ── Database (Postgres) ──────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/dream_dev

# ── Solana ───────────────────────────────────────────────
# Use a private RPC (Helius/Triton) in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# CAIP-2 chain id Privy broadcasts on. Mainnet shown below.
SOLANA_CAIP2=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

# ── Phoenix ──────────────────────────────────────────────
PHOENIX_API_URL=https://perp-api.phoenix.trade
# Builder fee authority that earns Flight builder bps on every taker fill.
FLIGHT_BUILDER_AUTHORITY=
# Comma-separated Phoenix program ids the server signer is allowed to touch.
# Used to build the Privy authorization policy (Phoenix-only custody guard).
PHOENIX_PROGRAM_IDS=

# ── Privy (server signing) ───────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization (owner) private key used to sign wallet-action requests
# server-side so trades execute while the user's app is closed.
PRIVY_AUTHORIZATION_KEY=
# Key-quorum ID the mobile client attaches as an additional signer (on-device
# consent). This is the public counterpart of PRIVY_AUTHORIZATION_KEY.
PRIVY_SIGNER_ID=
# Policy ID restricting the additional signer to Phoenix-only program actions.
PRIVY_PHOENIX_POLICY_ID=

# ── Engine ───────────────────────────────────────────────
# How often (ms) the orchestrator re-polls every followed leader.
LEADER_POLL_INTERVAL_MS=6000
# Worker base URL for copy attribution (broadcaster earnings).
DREAM_WORKER_URL=

# ── Supabase Notifications (optional) ────────────────────
# Enables copy-trade push notifications from dream-server by enqueueing
# events into Dream's existing Supabase notification backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: if the Supabase dispatch-notifications edge function is protected
# with NOTIFICATION_DISPATCH_SECRET, mirror that secret here so dream-server
# can trigger immediate FCM delivery after queueing a copy event.
NOTIFICATION_DISPATCH_SECRET=

# ── Billing ──────────────────────────────────────────────
# Treasury wallet that receives SOL micropayments for copy-point top-ups.
# The /v1/copy/points/credit route verifies payments landed here on-chain.
DREAM_TREASURY_ADDRESS=

# ── Telegram (optional) ──────────────────────────────────
# Developer alert bot. If left blank, no Telegram messages are sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Economics (basis points) ─────────────────────────────
# Builder fee collected on every taker fill (default 10 = 0.10 %).
BUILDER_FEE_BPS=10
# Fraction of the builder fee forwarded to the broadcaster (default 3000 = 30 %).
BROADCASTER_SHARE_BPS=3000
# Minimum claimable balance (USD) before a payout can be requested.
PAYOUT_MIN_USD=5

# ── Copy trading (V1, retired) ───────────────────────────
# Off by default in V2. "true" re-enables the copy engine + its routes.
COPY_ENGINE_ENABLED=false

# ── Dreams (V2) ──────────────────────────────────────────
# Stable public origin of this server. Coin metadata URIs are written
# on-chain and are immutable — use your own domain, not a Railway host.
PUBLIC_BASE_URL=https://api.trydream.fun
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Meteora DBC config from `npm run dbc:create-config -- --execute`.
# Empty disables coin launches (posting/funding still work).
DREAM_DBC_CONFIG=
# Permanent default image for dream coins.
DREAM_COIN_IMAGE_URL=https://trydream.fun/coin.png
PRIORITY_FEE_MICROLAMPORTS=50000
DREAM_REPORT_HIDE_THRESHOLD=5
DREAM_MAX_OPEN_PER_WALLET=3
# Seconds before a prepared-but-unconfirmed coin launch is reconciled on-chain.
DREAM_STALE_LAUNCH_SECONDS=180
# HMAC secret for Dreams session tokens — REQUIRED in production.
# Generate with: openssl rand -hex 32
DREAM_SESSION_SECRET=
# Operator token for POST /v1/dreams/:id/moderation (hide/unhide). Empty disables it.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

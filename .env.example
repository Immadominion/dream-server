# ── Server ───────────────────────────────────────────────
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated allowed CORS origins. Never use "*" in production.
CORS_ORIGINS=*

# ── Database (Postgres) ──────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/dream_dev

# ── Solana ───────────────────────────────────────────────
# Use a private RPC (Helius/Triton) in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# CAIP-2 chain id Privy broadcasts on. Mainnet shown below.
SOLANA_CAIP2=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

# ── Phoenix ──────────────────────────────────────────────
PHOENIX_API_URL=https://perp-api.phoenix.trade
# Builder fee authority that earns Flight builder bps on every taker fill.
FLIGHT_BUILDER_AUTHORITY=
# Comma-separated Phoenix program ids the server signer is allowed to touch.
# Used to build the Privy authorization policy (Phoenix-only custody guard).
PHOENIX_PROGRAM_IDS=

# ── Privy (server signing) ───────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization (owner) private key used to sign wallet-action requests
# server-side so trades execute while the user's app is closed.
PRIVY_AUTHORIZATION_KEY=
# Key-quorum ID the mobile client attaches as an additional signer (on-device
# consent). This is the public counterpart of PRIVY_AUTHORIZATION_KEY.
PRIVY_SIGNER_ID=
# Policy ID restricting the additional signer to Phoenix-only program actions.
PRIVY_PHOENIX_POLICY_ID=

# ── Engine ───────────────────────────────────────────────
# How often (ms) the orchestrator re-polls every followed leader.
LEADER_POLL_INTERVAL_MS=6000
# Worker base URL for copy attribution (broadcaster earnings).
DREAM_WORKER_URL=

# ── Billing ──────────────────────────────────────────────
# Treasury wallet that receives SOL micropayments for copy-point top-ups.
# The /v1/copy/points/credit route verifies payments landed here on-chain.
DREAM_TREASURY_ADDRESS=
